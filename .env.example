# OMIMIND multi-user deployment
ENVIRONMENT=development
DEPLOYMENT_MODE=multi_user

# Supabase Auth + Postgres (publishable key is safe for browser config)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_or_anon_key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_SERVICE_ROLE_KEY=server_only_service_role_key
DATABASE_URL=postgresql://user:password@host:5432/postgres?sslmode=require

# Persistent vector memory
QDRANT_URL=https://your-cluster-id.qdrant.io:6333
QDRANT_API_KEY=server_only_qdrant_api_key
EMBEDDING_PROVIDER=fastembed

# Server-managed Lyzr agents
LYZR_API_KEY=server_only_lyzr_api_key
LYZR_MANAGER_AGENT_ID=your_manager_agent_id
LYZR_MEMORY_RECALL_AGENT_ID=your_memory_recall_agent_id
LYZR_MEETING_ANALYST_AGENT_ID=your_meeting_analyst_agent_id
LYZR_ACTION_EXTRACTOR_AGENT_ID=your_action_extractor_agent_id
LYZR_FOLLOWUP_PLANNER_AGENT_ID=your_followup_planner_agent_id
LYZR_TIMEOUT_SECONDS=45

# Omi signing and device webhook configuration
OMI_WEBHOOK_SECRET=replace_with_a_distinct_omi_webhook_secret
OMI_API_KEY=optional_omi_api_key

# Local development safety
ALLOW_EPHEMERAL_MEMORY=true
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
PORT=8000
